{
  "campaign_id": "p3b-env-probe",
  "_comment": "Probe d'enrichissement d'environnement (bifurcation Phase 3). Cherche le hunger_depletion_rate (avec eat_hunger_threshold = 90, Variante C) qui fait retomber la meilleure politique fixe dans ~0.5-0.7 de survie sans saturer la vie mediane. Arms : les politiques fixes qui bornaient la plage a M0 (pf_er_rm best, pf_er_er worst, pf_rm_er / pf_rv_rm au milieu) + automate. 6 seeds d'entrainement. Le point retenu sera fige et rejouera oracle Phase 1 (nouveau M0) puis M1 / M2.",
  "base_config": "../p3b_env_probe.json",
  "arms": [
    {"name": "automate", "overrides": {"agents.individual.Rouge.decider_type": "automate"}},
    {"name": "pf_er_rm", "overrides": {"agents.individual.Rouge.decider_type": "politique_fixe", "agents.individual.Rouge.fixed_policy_s1": "errance", "agents.individual.Rouge.fixed_policy_s2": "ronce_memorisee"}},
    {"name": "pf_rm_er", "overrides": {"agents.individual.Rouge.decider_type": "politique_fixe", "agents.individual.Rouge.fixed_policy_s1": "ronce_memorisee", "agents.individual.Rouge.fixed_policy_s2": "errance"}},
    {"name": "pf_rv_rm", "overrides": {"agents.individual.Rouge.decider_type": "politique_fixe", "agents.individual.Rouge.fixed_policy_s1": "ronce_visible", "agents.individual.Rouge.fixed_policy_s2": "ronce_memorisee"}},
    {"name": "pf_er_er", "overrides": {"agents.individual.Rouge.decider_type": "politique_fixe", "agents.individual.Rouge.fixed_policy_s1": "errance", "agents.individual.Rouge.fixed_policy_s2": "errance"}}
  ],
  "parameter_grid": {
    "agents.individual.Rouge.hunger_depletion_rate": [0.7, 0.9, 1.1, 1.3]
  },
  "seeds": [20260901, 20260902, 20260903, 20260904, 20260905, 20260906],
  "repetitions": 1,
  "python_timeout_seconds": 900,
  "output_dir": "../../results/_p3b_env_probe"
}
